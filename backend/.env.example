# Required for live NASA FIRMS requests. Never commit a real value.
NASA_KEY=your_nasa_firms_key

# NASA transport and validation bounds.
NASA_CONNECT_TIMEOUT_SECONDS=5
NASA_READ_TIMEOUT_SECONDS=30
NASA_MAX_RESPONSE_BYTES=8388608
NASA_MAX_ROWS=10000
NASA_MAX_TEXT_LENGTH=32
NASA_FUTURE_TOLERANCE_SECONDS=900
NASA_HIGH_FRP_THRESHOLD_MW=1000

# Local-only anonymous client and request-attestation defaults. Production must
# use a random HMAC secret, enable both checks, and use Firestore rate limiting.
CLIENT_ID_HASH_SECRET=replace_with_a_random_local_secret
APP_CHECK_REQUIRED=false
CLIENT_ID_REQUIRED=false

# Shared rate limiting. Use memory locally to avoid Firestore writes.
RATE_LIMIT_BACKEND=memory
FIRESTORE_PROJECT_ID=your_gcp_project_id
TOKEN_BUCKET_CAPACITY=5
TOKEN_BUCKET_REFILL_SECONDS=12
TOKEN_BUCKET_STATE_TTL_SECONDS=86400
LOCAL_GUARD_CAPACITY=20
LOCAL_GUARD_REFILL_SECONDS=3

# Logging. Cloud Run sets K_SERVICE automatically, which disables file logging
# by default. Do not set K_SERVICE yourself.
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=logs/wildfire-api.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=19

# Historical analytics are optional and remain disabled for normal local work.
BIGQUERY_ENABLED=false
BIGQUERY_PROJECT_ID=your_gcp_project_id
BIGQUERY_DATASET=wildfires
BIGQUERY_LOCATION=europe-west1
BIGQUERY_MAX_BYTES_BILLED=52428800
BIGQUERY_PAYLOAD_MAX_BYTES=8388608
BIGQUERY_STORAGE_GUARD_BYTES=8589934592

# Required only when historical ingestion is enabled.
SCHEDULER_SERVICE_ACCOUNT=scheduler@your_gcp_project_id.iam.gserviceaccount.com
SCHEDULER_AUDIENCE=https://your-cloud-run-service.example.com/internal/ingest
